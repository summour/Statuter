{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User account profile and sync metadata",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "lastLoginAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email"]
    },
    "UserDeck": {
      "title": "UserDeck",
      "description": "A law deck owned by a user",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "shortName": { "type": "string" },
        "category": { "type": "string" },
        "description": { "type": "string" },
        "color": { "type": "string" },
        "icon": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "totalSections": { "type": "number" },
        "isCustom": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "category"]
    },
    "UserCard": {
      "title": "UserCard",
      "description": "A law card belonging to a user deck",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "deckId": { "type": "string" },
        "deckName": { "type": "string" },
        "deckShortName": { "type": "string" },
        "sectionNumber": { "type": "string" },
        "sectionRawNum": { "type": "number" },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "keywords": { "type": "array", "items": { "type": "string" } },
        "importantNote": { "type": "string" },
        "isStarred": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "deckId", "sectionNumber", "content"]
    },
    "CardChunk": {
      "title": "CardChunk",
      "description": "High-performance batch chunk of law cards to optimize quota and sync speed",
      "type": "object",
      "properties": {
        "deckId": { "type": "string" },
        "chunkIndex": { "type": "number" },
        "totalChunks": { "type": "number" },
        "count": { "type": "number" },
        "cards": { "type": "array" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["deckId", "chunkIndex", "cards"]
    },
    "OfficialDeck": {
      "title": "OfficialDeck",
      "description": "An official verified law deck published by system admins in the global library",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "shortName": { "type": "string" },
        "category": { "type": "string" },
        "description": { "type": "string" },
        "color": { "type": "string" },
        "icon": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "totalSections": { "type": "number" },
        "version": { "type": "string" },
        "isPublished": { "type": "boolean" },
        "author": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "category", "isPublished"]
    },
    "OfficialCardChunk": {
      "title": "OfficialCardChunk",
      "description": "Chunked card storage for official law statutes in the global library",
      "type": "object",
      "properties": {
        "deckId": { "type": "string" },
        "chunkIndex": { "type": "number" },
        "totalChunks": { "type": "number" },
        "count": { "type": "number" },
        "cards": { "type": "array" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["deckId", "chunkIndex", "cards"]
    }
  },
  "firestore": {
    "/official_decks/{deckId}": {
      "schema": "OfficialDeck",
      "description": "Global official law decks published by admin"
    },
    "/official_decks/{deckId}/chunks/{chunkId}": {
      "schema": "OfficialCardChunk",
      "description": "Chunked cards of official law decks for high speed bulk loading"
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile document"
    },
    "/users/{userId}/decks/{deckId}": {
      "schema": "UserDeck",
      "description": "User custom law decks"
    },
    "/users/{userId}/cards/{cardId}": {
      "schema": "UserCard",
      "description": "User law cards"
    },
    "/users/{userId}/deck_chunks/{chunkId}": {
      "schema": "CardChunk",
      "description": "Chunked card bundles for fast high-volume legal statute synchronization"
    }
  }
}
